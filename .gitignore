# ===== 白名单模式：仅跟踪 assets/ main/ README.md .github/ .gitignore，其余一律忽略 =====
/*
!/.gitignore
!/README.md
!/assets/
!/main/
!/.github/

# ===== 白名单目录内部仍需排除的隐私与临时文件（后写规则优先生效） =====
config.json
# ISSUE-CFG-02 原子写的滚动备份：与 config.json 同为密文材料，一律不入库
config.json.bak.*

# 测试目录：仅本地保留，不上传
main/tests/

# 环境变量与密钥文件
.env
.env.*
*.key
*.pem
*.p12
*.pfx
*.jks
*.session

*.db
*.db-journal
*.db-wal
*.db-shm
*.sqlite
*.sqlite3
*.sqlite-journal
*.sqlite-wal
*.sqlite-shm
usage.db

*.log
*.log.*
logs/
log/


__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/

# 测试与质量工具缓存
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
coverage.xml
htmlcov/


dist/
build/
out/
*.spec


.idea/
.vscode/
*.swp
*.swo
.DS_Store
Thumbs.db
desktop.ini

# 备份与临时文件
*.bak
*.tmp
*~


MCP_buildhelper.md
